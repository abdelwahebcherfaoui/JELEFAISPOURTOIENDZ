                  "",
                  "const email = pm.collectionVariables.get(\"partner_email\");",
                  "const body = pm.response.json();",
                  "pm.test(\"Le partenaire créé apparaît dans la liste\", () => {",
                  "    pm.expect(body.some((p) => p.email === email)).to.be.true;",
