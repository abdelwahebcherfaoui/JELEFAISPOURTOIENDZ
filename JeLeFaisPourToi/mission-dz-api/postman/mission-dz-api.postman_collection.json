          "name": "Créer un partenaire",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"partner_email\", \"garage.\" + Date.now() + \"@example.com\");"
