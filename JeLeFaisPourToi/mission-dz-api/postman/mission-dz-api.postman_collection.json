        {
          "name": "Login — Admin (seed)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Statut 200 OK\", () => pm.response.to.have.status(200));",
                  "",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set(\"admin_token\", body.accessToken);",
                  "",
                  "const payload = JSON.parse(Buffer.from(body.accessToken.split(\".\")[1], \"base64\").toString(\"utf8\"));",
                  "pm.collectionVariables.set(\"admin_id\", payload.sub);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@missiondz.test\",\n  \"password\": \"Admin1234!\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{base_url}}/api/auth/login", "host": ["{{base_url}}"], "path": ["api", "auth", "login"] }
          },
          "response": []
